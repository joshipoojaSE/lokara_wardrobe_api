APP_NAME=lokara-wardrobe
ENVIRONMENT=local
DEBUG=true

API_V1_PREFIX=/api/v1
CORS_ORIGINS=["*"]

# Local: the Postgres container from docker-compose.yml.
# Production: set DATABASE_URL to the managed database (no compose involved).
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/lokara_wardrobe
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/lokara_wardrobe_test

# Consumed by docker-compose.yml to provision the local Postgres container.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=lokara_wardrobe

# S3 image storage. The bucket is private; the API returns presigned GET URLs.
S3_BUCKET=lokara-wardrobe
S3_REGION=ap-south-1
S3_PRESIGN_EXPIRY_SECONDS=3600
# Leave unset for real AWS; point at http://localhost:9000 for MinIO/LocalStack.
# S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

IMAGE_MAX_BYTES=52428800
IMAGE_MAX_COUNT=8
IMAGE_ALLOWED_CONTENT_TYPES=["image/jpeg","image/png","image/webp"]
